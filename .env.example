# Copy to .env and fill in what you have. Every key is optional; sources without keys are skipped.

# Reddit (recommended, free): https://www.reddit.com/prefs/apps -> "create app" -> type "script"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Web search: covers Quora, Facebook, Instagram, Amazon reviews, TikTok, Trustpilot and forums.
# Brave has a free tier: https://api-dashboard.search.brave.com   (or use SerpApi: https://serpapi.com)
BRAVE_API_KEY=
SERPAPI_KEY=

# YouTube comments (free quota): Google Cloud console -> enable "YouTube Data API v3" -> API key
YOUTUBE_API_KEY=

# Optional AI-written analysis (--ai): https://console.anthropic.com
ANTHROPIC_API_KEY=
